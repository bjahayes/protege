{
  "name": "protege",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjahayes/protege.git"
  },
  "homepage": "https://github.com/bjahayes/protege#readme",
  "bugs": {
    "url": "https://github.com/bjahayes/protege/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Mission control for large Claude Code projects — see status, plans, and orchestrate multiple agents.",
  "scripts": {
    "dev": "node scripts/serve.mjs next dev -H 127.0.0.1 -p 4317",
    "build": "next build",
    "start": "node scripts/serve.mjs next start -H 127.0.0.1 -p 4317",
    "lint": "next lint",
    "test:diagram": "node --experimental-strip-types --no-warnings scripts/test-wire-route.ts",
    "test:keep": "node --experimental-strip-types --no-warnings scripts/test-keep.ts",
    "test": "npm run test:diagram && npm run test:keep"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.234",
    "better-sqlite3": "^11.8.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.16.1",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
